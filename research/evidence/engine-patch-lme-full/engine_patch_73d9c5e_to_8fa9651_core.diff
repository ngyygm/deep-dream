-            while True:
-                chunk = response.read(1024 * 1024)
-                if not chunk:
-                    break
-                output.write(chunk)
-        # Validate before replacing any existing cache.
-        json.loads(temp.read_text(encoding="utf-8"))
-        temp.replace(target)
