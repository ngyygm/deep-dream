+def test_f5_adjust_confidence_entity_batch_and_cap(tmp_path):
+    """批量腿 + 1.0 封顶 + 无置信度记录的 family 不动、未知 fid 不抛。"""
+    mgr = LibraryManager(str(tmp_path / "lib"))
