-        except ValueError:
-            pass
-    for fmt in (
-        "%Y/%m/%d (%a) %H:%M",
-        "%I:%M %p on %d %B, %Y",
-        "%Y/%m/%d %H:%M",
-        "%Y-%m-%d %H:%M",
-        "%Y-%m-%d",
-    ):
-        try:
-            return datetime.strptime(normalized, fmt)
-        except ValueError:
