-            text = "\n".join(str(row.get("text") or "") for row in contexts)
-        if re.search(r"\bhome country\b", text, re.I) and not re.search(
-            r"\bhome country\s*(?:is|was|,|:)\s*(?:the\s+)?[A-Z][A-Za-z-]+", text
