\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces LoCoMo per-category $J$ (binary CORRECT/WRONG accuracy, LLM-judged). Published rows reproduced verbatim from \citet  {chhikara2025mem0} (arXiv:2504.19413, Table~1): Mem0 reports mean$\pm $std over 10 runs with GPT-4o-mini as both answerer and judge (std omitted, all $\leq $0.75). \textbf  {Deep-Dream} applies the binary $J$ rubric pinned at repository commit \texttt  {4b61c5d}---a 2026 revision of the Mem0 judging prompt whose tolerance rules differ from the 2025 paper's Appendix~A---with Kimi-K3 as both answerer and judge (single run); the $\dagger $ row judges the same K3 answers with an independent Qwen3.7-plus cross-judge (cross-judge agreement 98.51\%). Same 841/282/96/321 question populations (1{,}540 total, Mem0-compatible subset). \emph  {Caveat:} the K3-answerer run is flagged \texttt  {formal\_claim\_allowed=false}---1{,}529 historical answer rows predate runtime-code fingerprinting (answers unchanged, sha 76af5772; per-item JSONL carries \texttt  {runtime\_code\_sha256}); reported as a diagnostic cross-judge result, not a fingerprint-complete formal result. Deterministic F1/BLEU-1 omitted for space (Table~\ref {tab:mem0-f1-bleu}). Weighted $J$, recomputed from the published category means under the 841/282/96/321 counts: Mem0 $\approx $62.14, $Mem0^g$ $\approx $61.36; the paper's own Table~2 reports Overall $J=66.88$ (Mem0) and $68.44$ ($Mem0^g$). Deep-Dream agg.\ $J$: 95.19\% / 94.22\% ($\dagger $).}}{21}{table.caption.26}\protected@file@percent }
\newlabel{tab:mem0-baselines}{{8}{21}{LoCoMo per-category $J$ (binary CORRECT/WRONG accuracy, LLM-judged). Published rows reproduced verbatim from \citet {chhikara2025mem0} (arXiv:2504.19413, Table~1): Mem0 reports mean$\pm $std over 10 runs with GPT-4o-mini as both answerer and judge (std omitted, all $\leq $0.75). \textbf {Deep-Dream} applies the binary $J$ rubric pinned at repository commit \texttt {4b61c5d}---a 2026 revision of the Mem0 judging prompt whose tolerance rules differ from the 2025 paper's Appendix~A---with Kimi-K3 as both answerer and judge (single run); the $\dagger $ row judges the same K3 answers with an independent Qwen3.7-plus cross-judge (cross-judge agreement 98.51\%). Same 841/282/96/321 question populations (1{,}540 total, Mem0-compatible subset). \emph {Caveat:} the K3-answerer run is flagged \texttt {formal\_claim\_allowed=false}---1{,}529 historical answer rows predate runtime-code fingerprinting (answers unchanged, sha 76af5772; per-item JSONL carries \texttt {runtime\_code\_sha256}); reported as a diagnostic cross-judge result, not a fingerprint-complete formal result. Deterministic F1/BLEU-1 omitted for space (Table~\ref {tab:mem0-f1-bleu}). Weighted $J$, recomputed from the published category means under the 841/282/96/321 counts: Mem0 $\approx $62.14, $Mem0^g$ $\approx $61.36; the paper's own Table~2 reports Overall $J=66.88$ (Mem0) and $68.44$ ($Mem0^g$). Deep-Dream agg.\ $J$: 95.19\% / 94.22\% ($\dagger $)}{table.caption.26}{}}
\newlabel{tab:mem0-baselines@cref}{{[table][8][2147483647]8}{[1][21][]21}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Published Deep Memory Retrieval (DMR) baselines reproduced verbatim from \citet  {rasmussen2025zep} (arXiv:2501.13956). DMR has 500 multi-session conversations (5 sessions, $\leq $12 messages each) with one single-hop fact-retrieval question per conversation. Deep-Dream does not currently run DMR, so this table is a contextual reference only.}}{21}{table.caption.27}\protected@file@percent }
