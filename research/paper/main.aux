\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Retrieval diagnostics on LoCoMo development/gate samples. (a) On 210 questions, fused retrieval has higher recall-all than either channel alone. (b) On 105 cases selected from prior errors, adding neighboring turns to the same lexical+semantic span retrieval increases evidence coverage. Both panels are development diagnostics rather than held-out final QA comparisons.}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:retrieval}{{2}{9}{Retrieval diagnostics on LoCoMo development/gate samples. (a) On 210 questions, fused retrieval has higher recall-all than either channel alone. (b) On 105 cases selected from prior errors, adding neighboring turns to the same lexical+semantic span retrieval increases evidence coverage. Both panels are development diagnostics rather than held-out final QA comparisons}{figure.caption.11}{}}
\newlabel{fig:retrieval@cref}{{[figure][2][]2}{[1][7][]9}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Diagnostic retrieval results. The channel rows use a 210-question development/gate set. The expansion rows use 105 cases selected from prior errors; lexical+semantic channels are held fixed across the span and neighbor rows.}}{9}{table.caption.12}\protected@file@percent }
\newlabel{tab:diagnostics}{{6}{9}{Diagnostic retrieval results. The channel rows use a 210-question development/gate set. The expansion rows use 105 cases selected from prior errors; lexical+semantic channels are held fixed across the span and neighbor rows}{table.caption.12}{}}
