    "remember": {
      "mode": "multi_step",
      "anchor_recall_rounds": 1,
      "named_entity_recall_rounds": 1,
      "abstract_recall_rounds": 1,
      "coverage_gap_rounds": 0,
      "relation_hint_rounds": 1,
      "relation_expand_rounds": 0,
      "relation_write_rounds": 1,
      "entity_write_batch_size": 16,
      "entity_content_batch_size": 16,
      "relation_content_batch_size": 24
    }
  }
