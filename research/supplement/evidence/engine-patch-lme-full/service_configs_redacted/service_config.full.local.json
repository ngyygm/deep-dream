{
  "host": "127.0.0.1",
  "port": 16202,
  "auto_port_fallback": false,
  "storage_path": ".benchmark_runs/real-smoke/library",
  "storage": {
    "backend": "sqlite",
    "vector_dim": 384
  },
  "llm": {
    "api_key": "***REDACTED***",
    "model": "qwen3.6-27b-awq",
    "base_url": "http://219.223.187.56:8000/v1",
    "think": false,
    "extra_body": {
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    },
    "max_tokens": 2048,
    "agent_max_tokens": 512,
