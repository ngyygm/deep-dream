{
  "host": "127.0.0.1",
  "port": 16200,
  "auto_port_fallback": false,
  "log_mode": "detail",
  "monitor_refresh_seconds": 1.0,
  "storage_path": "./library",
  "auth": {
    "enabled": null,
    "strict_mode": null,
    "allow_dev_key": false,
    "api_keys_file": null
  },
  "storage": {
    "backend": "sqlite",
    "vector_dim": 1024
  },
  "llm": {
    "mock": false,
    "api_key": "ollama",
    "model": "model_name",
    "base_url": "http://127.0.0.1:11434",
    "think": false,
    "protocol": "auto",
    "extra_body": {},
    "max_tokens": 3000,
    "context_window_tokens": 8000,
    "max_concurrency": 3,
    "alignment": {
      "enabled": true,
      "api_key": "ollama",
      "model": "alignment_model_name",
      "base_url": "http://127.0.0.1:11435",
      "think": false,
      "max_tokens": 8192
    }
  },
  "embedding": {
    "model": "Qwen/Qwen3-Embedding-0.6B",
    "device": "cpu",
    "trust_remote_code": false,
    "_comment": "设置 api_key/api_base 后走远程 OpenAI 兼容 /v1/embeddings，不加载本地模型（sentence-transformers 转为可选依赖）",
    "api_key": null,
    "api_base": null
  },
  "chunking": {
    "window_size": 1000,
    "overlap": 200
  },
  "runtime": {
    "concurrency": {
      "queue_workers": 1,
      "window_workers": "auto"
    },
    "task": {
      "load_cache_memory": false,
      "stall_timeout_seconds": 600,
      "queue_max_size": 1000
    },
    "retry": {
      "queue_max_retries": 2,
      "queue_retry_delay_seconds": 2
    }
  },
  "pipeline": {
    "search": {
      "similarity_threshold": 0.7,
      "max_similar_entities": 10,
      "content_snippet_length": 50,
      "relation_content_snippet_length": 50
    },
    "alignment": {
      "max_alignment_candidates": null
    },
    "extraction": {
      "prompt_episode_max_chars": 2000
    },
    "remember": {
      "profile": "strong-v1",
      "alignment_policy": "conservative",
      "max_entities_per_window": 16,
      "max_relations_per_window": 24,
      "episode_slice_chars": 0,
      "family_write_gate_enabled": true
    },
    "debug": {
      "distill_data_dir": "distill_pipeline"
    }
  },
  "flask_threaded": true,
  "max_request_bytes": 12582912
}
